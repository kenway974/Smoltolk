# Supabase — nouvelle instance dédiée SortiesRéunion (NE PAS réutiliser celle de ParisSorties)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# App
NEXT_PUBLIC_APP_URL=https://sortiesreunion.fr

# Cron (secret partagé entre Vercel cron et Edge Functions)
CRON_SECRET=votre_cron_secret

# Web Push (générer avec: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=votre_vapid_public_key
VAPID_PRIVATE_KEY=votre_vapid_private_key
VAPID_SUBJECT=mailto:contact@sortiesreunion.fr

# Email (Resend ou autre)
RESEND_API_KEY=votre_resend_api_key

# IA — modération (Claude Haiku)
ANTHROPIC_API_KEY=votre_anthropic_api_key

# Sentry (optionnel)
NEXT_PUBLIC_SENTRY_DSN=
